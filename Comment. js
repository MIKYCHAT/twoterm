
/*
  TWOTERM video comments
  Database: public.video_comments
  Reuses the existing Supabase client.
*/

(() => {
  "use strict";

  const db =
    window.supabaseClient ||
    window.sb ||
    window.twotermSupabase;

  if (!db) {
    console.error(
      "TWOTERM: Supabase client not found. " +
      "Connect the existing authentication helper first."
    );
    return;
  }

  async function load(videoId, container) {
    if (!videoId || !container) return;

    container.dataset.videoId = videoId;
    container.textContent = "Loading comments...";

    const { data, error } = await db
      .from("video_comments")
      .select("id, video_id, user_id, body, created_at")
      .eq("video_id", videoId)
      .order("created_at", { ascending: true });

    if (error) {
      console.error("Loading video comments failed:", error);
      container.textContent = "Unable to load comments.";
      return;
    }

    container.replaceChildren();

    if (!data.length) {
      container.textContent = "No comments yet. Be the first!";
      return;
    }

    const userIds = [...new Set(data.map(c => c.user_id))];

    const { data: profiles, error: profileError } = await db
      .from("profiles")
      .select("id, username, display_name, avatar_url")
      .in("id", userIds);

    if (profileError) {
      console.warn("Could not load commenter profiles:", profileError);
    }

    const profileMap = Object.fromEntries(
      (profiles || []).map(p => [p.id, p])
    );

    for (const comment of data) {
      const profile = profileMap[comment.user_id] || {};
      const name =
        profile.display_name ||
        profile.username ||
        "TWOTERM user";

      const item = document.createElement("article");
      item.className = "twoterm-comment";

      const avatar = document.createElement("div");
      avatar.className = "twoterm-comment-avatar";

      if (profile.avatar_url) {
        const img = document.createElement("img");
        img.src = profile.avatar_url;
        img.alt = "";
        img.loading = "lazy";
        avatar.appendChild(img);
      } else {
        avatar.textContent = name.charAt(0).toUpperCase();
      }

      const content = document.createElement("div");

      const username = document.createElement("strong");
      username.textContent = name;

      const message = document.createElement("p");
      message.textContent = comment.body;

      const date = document.createElement("small");
      date.textContent = new Date(
        comment.created_at
      ).toLocaleString();

      content.append(username, message, date);
      item.append(avatar, content);
      container.appendChild(item);
    }
  }

  async function submit(videoId, input, container, button) {
    const body = input?.value?.trim();

    if (!videoId || !body) {
      alert("Please write a comment first.");
      return;
    }

    if (body.length > 2000) {
      alert("Your comment is too long.");
      return;
    }

    const { data: auth, error: authError } =
      await db.auth.getUser();

    if (authError || !auth.user) {
      alert("Please log in to comment.");
      return;
    }

    const originalLabel = button?.textContent;

    if (button) {
      button.disabled = true;
      button.textContent = "Posting...";
    }

    try {
      const { error } = await db
        .from("video_comments")
        .insert({
          video_id: videoId,
          user_id: auth.user.id,
          body
        });

      if (error) throw error;

      input.value = "";
      await load(videoId, container);

    } catch (error) {
      console.error("Posting video comment failed:", error);
      alert("Comment failed. Please try again.");
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = originalLabel || "Comment";
      }
    }
  }

  window.TWOTERMComments = { load, submit };
})();
